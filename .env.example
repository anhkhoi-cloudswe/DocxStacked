# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Server & CORS
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# Database (SQLite default for local dev, Postgres for production)
DATABASE_URL=sqlite+aiosqlite:///data/gomde.db
SYNC_DATABASE_URL=sqlite:///data/gomde.db

# Storage & Browser Profile
STORAGE_DIR=data
BROWSER_PROFILE_DIR=data/browser_profile

# Crawler Settings
HEADLESS=false
BROWSER_CHANNEL=chrome
CONCURRENCY=1
MIN_DELAY_SECONDS=1.5
MAX_DELAY_SECONDS=4.0

# Optional AI Analysis
ANTHROPIC_API_KEY=
