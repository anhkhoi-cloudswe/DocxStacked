# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Server & CORS
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# Storage & Data Directory (Configurable via DOCXSTACKED_DATA_DIR)
# Default is ./data inside repository, or set absolute path outside repo:
# DOCXSTACKED_DATA_DIR=C:/Users/Admin/DocxStackedData
DOCXSTACKED_DATA_DIR=data

# Database (SQLite default for local dev)
DATABASE_URL=sqlite+aiosqlite:///data/docxstacked.db
SYNC_DATABASE_URL=sqlite:///data/docxstacked.db

# Storage & Browser Profile
STORAGE_DIR=data
BROWSER_PROFILE_DIR=data/browser_profile

# Crawler Settings
HEADLESS=false
BROWSER_CHANNEL=chrome
CONCURRENCY=1
MIN_DELAY_SECONDS=1.5
MAX_DELAY_SECONDS=4.0

# AI Provider API Keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ingest Token & Browser Extension ID (Auto-generated on first run if missing)
INGEST_TOKEN=
EXTENSION_ID=
