{
  "manifest_version": 3,
  "name": "DocxStacked - Tr\u1ee3 l\u00fd \u0111\u1ec1 thi FuOverflow",
  "version": "1.0.0",
  "description": "Extension t\u1ef1 \u0111\u1ed9ng thu th\u1eadp \u1ea3nh c\u00e2u h\u1ecfi v\u00e0 b\u00ecnh lu\u1eadn \u0111\u1ec1 thi tr\u00ean FuOverflow g\u1eedi v\u1ec1 DocxStacked xu\u1ea5t file Word.",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "https://fuoverflow.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "DocxStacked - M\u1edf Side Panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://fuoverflow.com/threads/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": ""
}